APP_NAME=Schedulix
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret-key-for-schedulix-jwt
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+psycopg://schedulix:schedulix_dev@db:5432/schedulix
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UNIVERSITY_NAME=Schedulix University
UNIVERSITY_LOGO=

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456789

SCHEDULING_MODE=HYBRID
PRIORITY_WEIGHT=0.65
SJF_WEIGHT=0.35
SCHEDULING_TIME_LIMIT=30

MEDIA_DIRECTORY=media

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=schedulix@university.edu
SMTP_USE_TLS=true
EMAIL_ENABLED=false
